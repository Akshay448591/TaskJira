PORT=5000
MONGO_URI=mongodb_uri
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Optional SMTP. If SMTP_HOST is empty, emails (password reset, invites) are printed in the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TaskJira <no-reply@taskjira.local>"
